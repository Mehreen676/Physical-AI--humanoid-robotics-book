# BookRAGAgent - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================================================
# FastAPI Configuration
# ============================================================================
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ============================================================================
# Qdrant Vector Database Configuration
# ============================================================================
# Qdrant Cloud URL (e.g., https://xxx.europe-west3-0.gcp.cloud.qdrant.io:6333)
QDRANT_URL=https://your-qdrant-url.gcp.cloud.qdrant.io:6333
# Qdrant API Key for authentication
QDRANT_API_KEY=your-qdrant-api-key-here
# Collection name for book chunks
COLLECTION_NAME=book-chunks

# ============================================================================
# OpenRouter LLM Configuration
# ============================================================================
# OpenRouter API Key for Claude 3.5 Sonnet access
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OpenRouter API URL (typically https://openrouter.io/api/v1)
OPENROUTER_URL=https://openrouter.io/api/v1
# Model name to use (e.g., claude-3-5-sonnet, gpt-4, etc.)
MODEL_NAME=claude-3-5-sonnet

# ============================================================================
# PostgreSQL Database Configuration (Neon)
# ============================================================================
# PostgreSQL connection string for session storage and user data
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/bookrag_db

# ============================================================================
# Embeddings Service Configuration
# ============================================================================
# Embeddings provider (cohere, openai, etc.)
EMBEDDINGS_PROVIDER=cohere
# API key for embeddings service (if different from main APIs)
EMBEDDINGS_API_KEY=your-embeddings-api-key-here

# ============================================================================
# RAG Configuration
# ============================================================================
# Number of top-k chunks to retrieve for each query
RETRIEVAL_TOP_K=5
# Minimum similarity score threshold for retrieved chunks (0-1)
SIMILARITY_THRESHOLD=0.7
# Days to retain conversation sessions before cleanup
SESSION_RETENTION_DAYS=90

# ============================================================================
# Docker & Deployment Configuration (Render)
# ============================================================================
# Port for uvicorn server (Render requires 10000 or dynamic port)
PORT=10000
# Host binding (use 0.0.0.0 for Docker/Render)
HOST=0.0.0.0

# ============================================================================
# Development Settings (local development only)
# ============================================================================
# Set to True in development for auto-reload
DEBUG=False
# Set to True to enable verbose logging in development
VERBOSE=False
