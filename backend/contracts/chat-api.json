{
  "openapi": "3.0.0",
  "info": {
    "title": "RAG Chat API",
    "description": "Retrieval-Augmented Generation API for humanoid robotics textbook queries",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Development server"
    },
    {
      "url": "https://your-backend-url.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "summary": "Query the RAG system",
        "description": "Submit a query to the RAG system and receive an answer with sources",
        "operationId": "chatQuery",
        "tags": ["chat"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Verify backend is running",
        "operationId": "healthCheck",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "Backend is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QueryRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 5000,
            "description": "User's question or query text"
          },
          "selected_text": {
            "type": "string",
            "description": "Optional highlighted text from the textbook for context"
          },
          "k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "Number of top chunks to retrieve"
          }
        }
      },
      "Source": {
        "type": "object",
        "required": ["url", "snippet"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL of the source textbook page"
          },
          "snippet": {
            "type": "string",
            "description": "Snippet of relevant content from source"
          },
          "chunk_position": {
            "type": "string",
            "description": "Position of chunk in document"
          },
          "similarity_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Similarity score of chunk to query"
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "required": ["query", "response", "sources", "confidence", "execution_time_ms", "status"],
        "properties": {
          "query": {
            "type": "string",
            "description": "Original query text"
          },
          "response": {
            "type": "string",
            "description": "Synthesized answer or retrieval results"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "description": "Array of source documents"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score of response"
          },
          "execution_time_ms": {
            "type": "integer",
            "description": "Execution time in milliseconds"
          },
          "status": {
            "type": "string",
            "enum": ["success", "error", "no_results"],
            "description": "Status of the query"
          },
          "error": {
            "type": "string",
            "description": "Error message if status is 'error'"
          }
        }
      }
    }
  }
}
